PORT=3000
# Supabase → Project Settings → Database → Connection string
# DATABASE_URL: "Transaction pooler" (porta 6543) — usado pelo app na Vercel
DATABASE_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: conexão direta (porta 5432) — usada só para migrations
DIRECT_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:3000
APP_TZ=America/Sao_Paulo
TZ_OFFSET=-03:00

# Vercel Cron envia este segredo ao chamar /api/cron/birthdays (gere um valor aleatório longo)
CRON_SECRET=

# Usuário inicial (seed)
ADMIN_EMAIL=admin@igreja.local
ADMIN_PASSWORD=Mudar@123

# WhatsApp: log | evolution | cloud
WHATSAPP_PROVIDER=log
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=

# Aniversariantes: na Vercel o agendamento está em vercel.json (11:00 UTC = 08:00 Brasília).
# BIRTHDAY_CRON/ENABLED valem só ao rodar localmente com `npm start`.
BIRTHDAY_CRON=0 8 * * *
BIRTHDAY_JOB_ENABLED=false

# Pagamentos: mock | mercadopago
PAYMENT_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=
